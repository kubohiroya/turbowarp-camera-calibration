node_modules/
# Built from src/runtime.ts for consumers to import. Regenerated on every build:
# reviewing the declarations in each diff would cost more than it catches, and
# `prepack` rebuilds them before anything is published.
lib/
coverage/
*.log
.DS_Store

# Tool artifacts. These exist because of what a machine runs, not because of this
# project. Listed here as well as globally, so the repository does not depend on
# each developer having configured the same global ignores.
.claude/
.playwright-mcp/
.serena/
